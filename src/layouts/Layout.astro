---
import "@/styles/global.css";
import Logo from "@/components/site/Logo.astro";
import { getSettings } from "@/lib/settings";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  bare?: boolean;
}

const settings = await getSettings();
const {
  title = `${settings.brand_name} | ${settings.tagline}`,
  description = settings.hero_body,
  image = settings.hero_image,
  bare = false,
} = Astro.props;

const path = Astro.url.pathname;
const nav = [
  { href: "/courses", label: "Courses" },
  { href: "/fleet", label: "Fleet" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={settings.brand_name} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta name="theme-color" content="#f3f1ea" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
  </head>
  <body class:list={["grain", "flex", "min-h-screen", "flex-col"]}>
    {!bare && (
      <header class="sticky top-0 z-50 border-b border-ink/10 bg-paper/90 backdrop-blur-md">
        <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:h-20">
          <a
            href="/"
            class="group flex items-center"
            aria-label="Tokyoride home"
          >
            <Logo size="md" />
          </a>

          <nav class="hidden items-center gap-1 md:flex">
            {nav.map((item) => {
              const active =
                path === item.href || path.startsWith(`${item.href}/`);
              return (
                <a
                  href={item.href}
                  class:list={[
                    "mono-label border-b-2 px-3 py-2 transition-colors",
                    active
                      ? "border-signal text-ink"
                      : "border-transparent text-ink/70 hover:border-ink/20 hover:text-ink",
                  ]}
                >
                  {item.label}
                </a>
              );
            })}
            <a href="/courses" class="hard-btn ml-4 !py-2.5 !text-xs">
              Reserve
            </a>
          </nav>

          <button
            id="nav-toggle"
            type="button"
            aria-label="Toggle navigation"
            aria-expanded="false"
            class="flex h-10 items-center gap-2 border border-ink/35 bg-ink/5 px-3 text-ink md:hidden"
          >
            <span class="mono-label">Menu</span>
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>

        <div
          id="nav-menu"
          class="hidden border-t border-ink/10 bg-paper md:hidden"
        >
          {nav.map((item) => (
            <a
              href={item.href}
              class="mono-label block border-b border-ink/5 px-5 py-4 text-ink/85"
            >
              {item.label}
            </a>
          ))}
          <div class="p-5">
            <a href="/courses" class="hard-btn w-full">
              Reserve a car
            </a>
          </div>
        </div>
      </header>
    )}

    <slot />

    {!bare && (
      <footer class="mt-auto border-t border-ink/10 bg-paper">
        <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:grid-cols-2 lg:grid-cols-4">
          <div class="sm:col-span-2 lg:col-span-1">
            <Logo size="lg" />
            <p class="mt-3 max-w-xs text-sm leading-relaxed text-ink/70">
              JDM driving courses in Japan.
            </p>
          </div>

          <div>
            <p class="mono-label text-ink/55">Where</p>
            <p class="mt-3 text-sm text-ink/85">{settings.address}</p>
            <p class="mt-1 font-mono text-xs text-ink/60">{settings.hours}</p>
          </div>

          <div>
            <p class="mono-label text-ink/55">Contact</p>
            <a
              href={`mailto:${settings.email}`}
              class="mt-3 block text-sm text-ink/85 hover:text-signal"
            >
              {settings.email}
            </a>
            <a
              href={`tel:${settings.phone.replace(/\s/g, "")}`}
              class="mt-1 block font-mono text-xs text-ink/70 hover:text-signal"
            >
              {settings.phone}
            </a>
            {settings.instagram && (
              <a
                href={settings.instagram}
                class="mt-1 block font-mono text-xs text-ink/70 hover:text-signal"
              >
                Instagram
              </a>
            )}
          </div>

          <div>
            <p class="mono-label text-ink/55">Legal</p>
            <a
              href="/legal/terms"
              class="mt-3 block text-sm text-ink/85 hover:text-signal"
            >
              Rental terms
            </a>
            <a
              href="/legal/cancellation"
              class="mt-1 block text-sm text-ink/85 hover:text-signal"
            >
              Cancellation
            </a>
            <a
              href="/legal/privacy"
              class="mt-1 block text-sm text-ink/85 hover:text-signal"
            >
              Privacy
            </a>
            <a
              href="/legal/tokushoho"
              class="mt-1 block text-sm text-ink/85 hover:text-signal"
            >
              Business information
            </a>
          </div>
        </div>

        <div class="border-t border-ink/10">
          <div class="mx-auto flex max-w-6xl flex-col gap-2 px-5 py-5 font-mono text-xs uppercase tracking-[0.14em] text-ink/50 sm:flex-row sm:items-center sm:justify-between">
            <span>© {year} Tokyoride. All rights reserved.</span>
            <span>Fujisawa · Kanagawa · Japan</span>
          </div>
        </div>
      </footer>
    )}

    <script is:inline>
      const toggle = document.getElementById("nav-toggle");
      const menu = document.getElementById("nav-menu");
      if (toggle && menu) {
        toggle.addEventListener("click", () => {
          const open = !menu.classList.contains("hidden");
          menu.classList.toggle("hidden", open);
          toggle.setAttribute("aria-expanded", String(!open));
        });
      }
    </script>
  </body>
</html>
