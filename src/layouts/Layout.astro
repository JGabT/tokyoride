---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Tokyoride | AHS JDM Experiences",
  description = "Curated JDM Tours & Garage Experiences by Sam Otani (AHS)",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- ClientRouter intercepts clicks and swaps content without full-page reloads -->
    <ClientRouter />
  </head>
  <body class="bg-zinc-50 text-zinc-900 min-h-screen">
    <!-- Shared Site Header -->
    <header class="border-b border-zinc-800/80 bg-linear-to-r from-zinc-950 via-zinc-900 to-zinc-950 text-white shadow-md backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-18 sm:h-20 flex items-center justify-between gap-3">
        <a href="/" class="flex flex-col group transition-opacity hover:opacity-95 min-w-0">
          <span class="text-xl sm:text-2xl font-black tracking-tight uppercase text-white group-hover:text-red-500 transition-colors truncate">
            Tokyoride
          </span>
          <span class="text-[10px] sm:text-xs text-zinc-400 font-medium hidden md:block truncate">
            Curated JDM Tours & Garage Experiences by Sam Otani (AHS)
          </span>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex items-center gap-1 sm:gap-2">
          <a
            href="/#tours"
            class="relative px-3.5 py-2 text-xs sm:text-sm font-semibold tracking-wider uppercase text-zinc-200 rounded-lg transition-all duration-300 border border-transparent hover:text-white hover:border-red-500/50 hover:bg-linear-to-r hover:from-red-600/20 hover:via-amber-500/20 hover:to-red-600/20 hover:shadow-[0_0_15px_rgba(239,68,68,0.35)]"
          >
            Tours
          </a>
          <a
            href="/about"
            class="relative px-3.5 py-2 text-xs sm:text-sm font-semibold tracking-wider uppercase text-zinc-200 rounded-lg transition-all duration-300 border border-transparent hover:text-white hover:border-red-500/50 hover:bg-linear-to-r hover:from-red-600/20 hover:via-amber-500/20 hover:to-red-600/20 hover:shadow-[0_0_15px_rgba(239,68,68,0.35)]"
          >
            About Us
          </a>
          <a
            href="/contact"
            class="relative px-3.5 py-2 text-xs sm:text-sm font-semibold tracking-wider uppercase text-zinc-200 rounded-lg transition-all duration-300 border border-transparent hover:text-white hover:border-red-500/50 hover:bg-linear-to-r hover:from-red-600/20 hover:via-amber-500/20 hover:to-red-600/20 hover:shadow-[0_0_15px_rgba(239,68,68,0.35)]"
          >
            Contact
          </a>
        </nav>

        <span class="text-xs font-mono tracking-widest text-zinc-400 uppercase hidden lg:block shrink-0">
          Fujisawa • Kanagawa
        </span>

        <!-- Mobile Menu Toggle Button -->
        <button
          id="mobile-nav-toggle"
          type="button"
          aria-label="Toggle navigation menu"
          class="md:hidden flex items-center justify-center w-10 h-10 rounded-lg border border-zinc-700/80 bg-zinc-900/90 text-zinc-200 hover:text-white hover:border-red-500 focus:outline-none cursor-pointer"
        >
          <svg id="hamburger-icon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Mobile Dropdown Menu -->
      <div id="mobile-menu" class="hidden md:hidden border-t border-zinc-800 bg-zinc-950/98 backdrop-blur-xl px-4 py-4 space-y-2">
        <a
          href="/#tours"
          class="block px-4 py-2.5 rounded-lg text-sm font-semibold uppercase tracking-wider text-zinc-200 hover:text-white hover:bg-red-600/20 hover:border hover:border-red-500/40 transition-colors mobile-nav-link"
        >
          Tours
        </a>
        <a
          href="/about"
          class="block px-4 py-2.5 rounded-lg text-sm font-semibold uppercase tracking-wider text-zinc-200 hover:text-white hover:bg-red-600/20 hover:border hover:border-red-500/40 transition-colors mobile-nav-link"
        >
          About Us
        </a>
        <a
          href="/contact"
          class="block px-4 py-2.5 rounded-lg text-sm font-semibold uppercase tracking-wider text-zinc-200 hover:text-white hover:bg-red-600/20 hover:border hover:border-red-500/40 transition-colors mobile-nav-link"
        >
          Contact
        </a>
        <div class="pt-3 border-t border-zinc-800/80 text-[11px] font-mono text-zinc-400 px-4 flex justify-between items-center">
          <span>AHS FUJISAWA</span>
          <span>+81 46-258-9614</span>
        </div>
      </div>
    </header>

    <script is:inline>
      function setupMobileNav() {
        const toggleBtn = document.getElementById("mobile-nav-toggle");
        const mobileMenu = document.getElementById("mobile-menu");
        const hamburgerIcon = document.getElementById("hamburger-icon");
        const closeIcon = document.getElementById("close-icon");

        if (!toggleBtn || !mobileMenu) return;

        toggleBtn.onclick = () => {
          const isOpen = !mobileMenu.classList.contains("hidden");
          if (isOpen) {
            mobileMenu.classList.add("hidden");
            hamburgerIcon?.classList.remove("hidden");
            closeIcon?.classList.add("hidden");
          } else {
            mobileMenu.classList.remove("hidden");
            hamburgerIcon?.classList.add("hidden");
            closeIcon?.classList.remove("hidden");
          }
        };

        const navLinks = mobileMenu.querySelectorAll(".mobile-nav-link");
        navLinks.forEach((link) => {
          link.onclick = () => {
            mobileMenu.classList.add("hidden");
            hamburgerIcon?.classList.remove("hidden");
            closeIcon?.classList.add("hidden");
          };
        });
      }

      setupMobileNav();
      document.addEventListener("astro:page-load", setupMobileNav);
    </script>

    <!-- Page Content Injected Here -->
    <slot />

    <!-- Shared Site Footer -->
    <footer class="border-t border-zinc-200 bg-white mt-16 py-10">
      <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-6 text-xs text-zinc-500">
        <div>
          <p class="font-bold text-zinc-900 uppercase tracking-tight text-sm">
            Tokyoride
          </p>
          <p class="mt-1">
            Auto Hobby Shop (AHS) • Fujisawa, Kanagawa, Japan
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-6 font-mono text-zinc-600">
          <a
            href="tel:+81462589614"
            class="hover:text-red-600 transition-colors"
          >
            +81 46-258-9614
          </a>
          <span class="hidden sm:inline text-zinc-300">•</span>
          <a
            href="mailto:atsugihobbyshopahs@gmail.com"
            class="hover:text-red-600 transition-colors"
          >
            atsugihobbyshopahs@gmail.com
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
