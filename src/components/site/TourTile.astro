---
import type { Tour } from "@/lib/db/schema";

interface Props {
  tour: Tour;
  price: number | null;
}

const { tour, price } = Astro.props;
---

<a
  href={`/courses/${tour.id}`}
  class="group flex flex-col justify-between border border-ink/12 bg-white p-5 transition-colors hover:border-signal/70"
>
  <div>
    <div class="flex items-start justify-between gap-4">
      <span class="mono-label text-ink/55">{tour.durationHours} HRS.</span>
      {price != null && (
        <span class="price-tag">From ¥{price.toLocaleString("en-US")}</span>
      )}
    </div>

    <h3 class="mt-6 font-display text-xl leading-[0.95] text-ink transition-colors group-hover:text-signal">
      {tour.title}
    </h3>
    <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-ink/70">
      {tour.subtitle}
    </p>
  </div>

  <div class="mt-6 flex items-center justify-between border-t border-ink/10 pt-4">
    <span class="mono-label text-ink/50">{tour.meetingLabel}</span>
    <span class="flex items-center gap-2 mono-label text-ink transition-colors group-hover:text-signal">
      Details
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M5 12h14M12 5l7 7-7 7" />
      </svg>
    </span>
  </div>
</a>
