---
import type { Vehicle } from "@/lib/db/schema";

interface Props {
  vehicle: Vehicle;
  price?: number | null;
}

const { vehicle, price = null } = Astro.props;
---

<a
  href={`/fleet#${vehicle.id}`}
  class="group relative flex flex-col overflow-hidden border border-ink/12 bg-white transition-colors hover:border-signal/70"
>
  <div class="relative aspect-[4/3] overflow-hidden bg-[#e9e6dd]">
    {vehicle.photo ? (
      <img
        src={vehicle.photo}
        alt={vehicle.name}
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        loading="lazy"
      />
    ) : (
      <div class="flex h-full w-full items-center justify-center">
        <span class="display select-none text-[92px] leading-none text-ink/23">
          {vehicle.chassisCode || "JDM"}
        </span>
      </div>
    )}
    <span class="plate absolute left-3 top-3 border-ink/40 bg-paper/80 text-ink">
      <small>CHASSIS</small>
      <span>{vehicle.chassisCode || "—"}</span>
    </span>
    <!-- <span class="mono-label absolute right-3 top-3 bg-paper/80 px-2 py-1 text-ink/85">
      {vehicle.kind === "van" ? "Van" : "Car"}
    </span> -->
  </div>

  <div class="flex flex-1 flex-col p-4">
    <h3 class="font-display text-xl leading-none text-ink">{vehicle.name}</h3>
    <p class="mono-label mt-2 text-ink/55">
      {vehicle.transmission} · {vehicle.seats} seats
    </p>
    {vehicle.blurb && (
      <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-ink/70">
        {vehicle.blurb}
      </p>
    )}

    <div class="mt-auto flex items-end justify-between gap-3 border-t border-ink/10 pt-3">
      <span class="mono-label text-ink/45 transition-colors group-hover:text-signal">
        Details →
      </span>
      {price != null && (
        <span class="price-tag">From ¥{price.toLocaleString("en-US")}</span>
      )}
    </div>
  </div>
</a>
