---
import Layout from "@/layouts/Layout.astro";
import VehicleTile from "@/components/site/VehicleTile.astro";
import TourTile from "@/components/site/TourTile.astro";
import MapView from "@/components/map/MapView.tsx";
import {
  getActiveTours,
  getFleetForTour,
  getFromPrice,
  getVehicles,
  getSiteMap,
} from "@/lib/catalog";
import { getSettings } from "@/lib/settings";

const settings = await getSettings();
const [tours, allVehicles, siteMap] = await Promise.all([
  getActiveTours(),
  getVehicles(),
  getSiteMap(),
]);

const fleet = allVehicles.filter((v) => v.kind === "car");
const van = allVehicles.find((v) => v.kind === "van");

const prices = await Promise.all(tours.map((t) => getFromPrice(t.id)));
const validPrices = prices.filter((p): p is number => p != null);
const cheapest = validPrices.length ? Math.min(...validPrices) : 0;

const vehicleFrom = await Promise.all(
  fleet.map(async (v) => {
    let min: number | null = null;
    for (const t of tours) {
      const list = await getFleetForTour(t.id);
      const hit = list.find((x) => x.id === v.id);
      if (hit && (min == null || hit.priceJpy < min)) min = hit.priceJpy;
    }
    return min;
  }),
);

const marquee = [
  "Daikoku PA",
  "Wangan",
  "Hakone Touge",
  "Shonan 134",
  "Fuji Speedway",
  "Fujisawa",
];
const points = siteMap.length
  ? siteMap.map((p) => ({
      lat: p.lat,
      lng: p.lng,
      label: p.label,
      kind: p.kind as any,
    }))
  : [
      {
        lat: settings.lat,
        lng: settings.lng,
        label: "Fujisawa base",
        kind: "site" as const,
      },
    ];
---

<Layout>
  <!-- HERO -->
  <section class="border-b border-ink/10">
    <div class="grid lg:grid-cols-[1.05fr_0.95fr]">
      <div class="px-5 py-10 sm:py-14 lg:py-16 lg:pl-[max(1.25rem,calc((100vw-72rem)/2+1.25rem))] lg:pr-12">
        <p class="section-label">{settings.hero_kicker}</p>

        <h1 class="display mt-5 text-[clamp(2.5rem,5.2vw,4.4rem)] text-ink">
          Drive the cars
          <br />
          you grew up on.
        </h1>

        <p class="mt-5 max-w-md text-base leading-relaxed text-ink/70">
          {settings.hero_body}
        </p>

        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/courses" class="hard-btn">
            Reserve a car
          </a>
          <a href="/fleet" class="hard-btn hard-btn--ghost">
            See the fleet
          </a>
        </div>

        <dl class="mt-10 grid max-w-md grid-cols-2 gap-x-6 gap-y-5 border-t border-ink/12 pt-5 sm:grid-cols-3">
          {[
            { k: "Fleet", v: `${fleet.length} cars` },
            { k: "Courses", v: `${tours.length}` },
            { k: "Pickup", v: "09:00–20:00" },
          ].map((stat) => (
            <div>
              <dt class="mono-label text-ink/45">{stat.k}</dt>
              <dd class="mt-1 font-display text-lg text-ink">{stat.v}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="relative min-h-[320px] border-ink/10 sm:min-h-[420px] lg:min-h-[600px] lg:border-l">
        <img
          src={settings.hero_image}
          alt="JDM car on a Kanagawa coastal road"
          class="absolute inset-0 h-full w-full object-cover object-[62%_center]"
        />
        {cheapest > 0 && (
          <span class="price-tag absolute right-5 top-5">
            From ¥{cheapest.toLocaleString("en-US")}
          </span>
        )}
        <div class="absolute bottom-5 left-5 flex items-center gap-2 bg-paper px-3 py-2">
          <span class="h-2 w-2 bg-signal"></span>
          <span class="mono-label text-ink/80">
            Fujisawa, Kanagawa
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- MARQUEE -->
  <div
    aria-hidden="true"
    class="marquee border-b border-ink/10 bg-signal py-4 text-white"
  >
    <div class="marquee__track">
      {[0, 1].map(() => (
        <div class="marquee__group">
          {[...marquee, ...marquee, ...marquee, ...marquee].map((item) => (
            <span class="flex items-center gap-6 whitespace-nowrap font-display text-xl uppercase leading-none tracking-[0.02em] sm:text-2xl">
              {item}
              <span class="text-white/55">/</span>
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>

  <!-- FLEET -->
  <section class="mx-auto max-w-6xl px-5 py-16 sm:py-24">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="section-label">01 / The fleet</p>
        <h2 class="display mt-2 text-[clamp(2rem,5vw,3.5rem)] text-ink">
          Pick your weapon
        </h2>
      </div>
      <a
        href="/fleet"
        class="mono-label border-b border-ink/30 pb-1 text-ink/85 hover:border-signal hover:text-signal"
      >
        Full list →
      </a>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {fleet.map((vehicle, i) => (
        <VehicleTile vehicle={vehicle} price={vehicleFrom[i]} />
      ))}
    </div>

    {van && (
      <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border border-ink/12 bg-white px-4 py-3">
        <p class="mono-label text-ink/60">
          Bringing the family or need extra space? Add the support van to any
          booking.
        </p>
        <a
          href="/fleet"
          class="mono-label border-b border-ink/25 pb-0.5 text-ink/75 hover:border-signal hover:text-signal"
        >
          See the van →
        </a>
      </div>
    )}
  </section>

  <!-- TOURS -->
  <section class="border-y border-ink/10 bg-[#eae7de]">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:py-24">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="section-label">02 / Courses</p>
          <h2 class="display mt-2 text-[clamp(2rem,5vw,3.5rem)] text-ink">
            Three courses. One fleet.
          </h2>
        </div>
        <p class="max-w-sm text-sm leading-relaxed text-ink/65">
          Every course takes you through the best roads in Japan.
        </p>
      </div>

      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {tours.map((tour, i) => (
          <TourTile tour={tour} price={prices[i]} />
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="mx-auto max-w-6xl px-5 py-16 sm:py-24">
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="section-label">03 / How it works</p>
        <h2 class="display mt-2 text-[clamp(2rem,5vw,3.5rem)] text-ink">
          Keys in Fujisawa.
          <br />
          Roads are yours.
        </h2>
        <p class="mt-5 max-w-md text-sm leading-relaxed text-ink/70">
          You drive. We handle the car, the route and the paperwork. Bring a
          valid license and an International Driving Permit.
        </p>
        <a href="/courses" class="hard-btn mt-7">
          Check availability
        </a>
      </div>

      <ol class="divide-y divide-ink/10 border-y border-ink/10">
        {[
          {
            n: "01",
            t: "Pick a route and a date",
            d: "Every departure is a fixed window, so the car comes back the same night.",
          },
          {
            n: "02",
            t: "Choose one car — or three",
            d: "Booking a convoy? Each car needs its own named driver at checkout.",
          },
          {
            n: "03",
            t: "Pay securely",
            d: "Cards processed through AirPay. The car is held for 30 minutes while you pay.",
          },
          {
            n: "04",
            t: "Collect and drive",
            d: "Passport, home license, IDP. Walkaround, then the keys are yours.",
          },
        ].map((step) => (
          <li class="flex gap-6 py-6">
            <span class="font-mono text-xs text-signal">{step.n}</span>
            <div>
              <p class="font-display text-xl leading-none text-ink">{step.t}</p>
              <p class="mt-2 text-sm leading-relaxed text-ink/65">{step.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- MAP -->
  <section class="border-t border-ink/10">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="section-label">04 / The base</p>
          <h2 class="display mt-2 text-3xl text-ink">Fujisawa, Kanagawa</h2>
        </div>
        <a
          href={`https://www.google.com/maps/search/?api=1&query=${settings.lat},${settings.lng}`}
          target="_blank"
          rel="noopener"
          class="mono-label border-b border-ink/30 pb-1 text-ink/85 hover:border-signal hover:text-signal"
        >
          Open in Maps →
        </a>
      </div>
      <MapView client:visible points={points} height={360} />
    </div>
  </section>
</Layout>
