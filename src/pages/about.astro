---
import Layout from "@/layouts/Layout.astro";
import MapView from "@/components/map/MapView.tsx";
import { getSettings } from "@/lib/settings";

const settings = await getSettings();
---

<Layout
  title={`About | ${settings.brand_name}`}
  description="Tokyoride is a self-drive JDM rental based in Fujisawa, Kanagawa."
>
  <main class="mx-auto max-w-6xl px-5 py-14 sm:py-20">
    <p class="section-label">About</p>
    <h1 class="display mt-3 max-w-4xl text-[clamp(2.6rem,8vw,5.5rem)] text-ink">
      Built in a garage,
      <br />
      not a boardroom<span class="text-signal">.</span>
    </h1>

    <div class="mt-12 grid gap-12 lg:grid-cols-[1fr_0.9fr]">
      <div class="space-y-6 text-sm leading-relaxed text-ink/80 sm:text-base">
        <p>
          Tokyoride is a small self-drive rental operating out of Fujisawa,
          Kanagawa. Four cars, one workshop, and a short list of routes we
          actually drive ourselves.
        </p>
        <p>
          The cars are the point. An R32 and an R34 with the RB26, an R35 for
          people who want the modern one, and an AE86 for the purists. They are
          maintained in-house, not outsourced to another company.
        </p>
        <p>
          We let you enjoy Japan with the freedom of self-driving: Daikoku on a
          Friday night, the Shonan coast at golden hour, Hakone's touge, or Fuji
          Speedway. You get the keys, a briefing, and a road worth the trip.
        </p>
        <p>
          You drive or you let us drive. We handle the rest: maintenance,
          paperwork, and the route. No waiting around.
        </p>
        <div class="border-l-2 border-signal pl-5">
          <p class="text-ink/85">
            No tour buses. No group itineraries. You drive, we handle everything
            around the car.
          </p>
        </div>
      </div>

      <div class="space-y-4">
        <MapView
          client:visible
          points={[
            {
              lat: settings.lat,
              lng: settings.lng,
              label: "Fujisawa base",
              kind: "site",
            },
          ]}
          height={300}
          zoom={12}
        />
        <div class="border border-ink/12 bg-white p-5">
          <p class="section-label">The base</p>
          <p class="mt-2 text-sm text-ink/85">{settings.address}</p>
          <p class="mt-1 font-mono text-xs text-ink/55">{settings.hours}</p>
          <a
            href={`https://www.google.com/maps/search/?api=1&query=${settings.lat},${settings.lng}`}
            target="_blank"
            rel="noopener"
            class="mono-label mt-4 inline-block border-b border-ink/25 pb-1 text-ink/75 hover:text-signal"
          >
            Get directions ↗
          </a>
        </div>
      </div>
    </div>

    <section class="mt-16 border-t border-ink/10 pt-12">
      <p class="section-label">Before you book</p>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {[
          {
            t: "License",
            d: "Home license + 1949 Geneva IDP. Manual gearbox experience required.",
          },
          { t: "Age", d: "25+. Under 25 on request." },
          {
            t: "Deposit",
            d: "Card hold at pickup or cash payment, released after the return walkaround.",
          },
          {
            t: "Fuel",
            d: "Car leaves full. Return full, or we refuel and charge the difference.",
          },
        ].map((item) => (
          <div>
            <p class="font-display text-lg text-ink">{item.t}</p>
            <p class="mt-2 text-sm leading-relaxed text-ink/65">{item.d}</p>
          </div>
        ))}
      </div>
    </section>
  </main>
</Layout>
