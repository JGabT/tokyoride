---
import { getBookingDetail } from "@/lib/receipts";
import { formatJpy, jstLong, jstTime } from "@/lib/dates";

const { id } = Astro.params;
const token = Astro.url.searchParams.get("t") ?? "";
const detail = id ? await getBookingDetail(id) : null;

if (!detail || detail.booking.accessToken !== token) {
  return Astro.redirect("/courses");
}

const expired = detail.booking.status !== "pending";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AirPay Checkout</title>
    <style>
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        background: #eef1f4;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        color: #1c2430;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
      }
      .shell { width: 100%; max-width: 460px; }
      .brand {
        display: flex; align-items: center; justify-content: space-between;
        margin-bottom: 14px;
      }
      .brand-name { font-size: 20px; font-weight: 800; letter-spacing: -0.02em; }
      .brand-name span { color: #0b7dda; }
      .sandbox {
        font-size: 9px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase;
        color: #8a5a00; background: #ffe9b8; border: 1px solid #f0c96a; padding: 4px 8px;
      }
      .card {
        background: #fff; border-radius: 10px; overflow: hidden;
        box-shadow: 0 10px 30px rgba(20, 30, 45, .12);
      }
      .summary { padding: 22px 24px; border-bottom: 1px solid #e6eaef; }
      .row { display: flex; justify-content: space-between; gap: 12px; font-size: 13px; }
      .row + .row { margin-top: 10px; }
      .muted { color: #6a7686; }
      .amount { font-size: 30px; font-weight: 700; margin: 6px 0 0; letter-spacing: -0.02em; }
      .body { padding: 22px 24px 26px; }
      .label { font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #6a7686; display: block; margin-bottom: 6px; }
      .field {
        width: 100%; padding: 11px 12px; border: 1px solid #cfd6e0; border-radius: 6px;
        font-size: 14px; background: #fbfcfd; color: #1c2430;
      }
      .field + .label { margin-top: 14px; }
      .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
      .tabs { display: flex; gap: 6px; margin-bottom: 18px; }
      .tab {
        flex: 1; text-align: center; font-size: 12px; font-weight: 600; padding: 9px;
        border: 1px solid #cfd6e0; border-radius: 6px; color: #6a7686; background: #fff;
      }
      .tab.active { border-color: #0b7dda; color: #0b7dda; background: #f2f8ff; }
      .pay {
        width: 100%; margin-top: 20px; padding: 14px; border: 0; border-radius: 7px;
        background: #0b7dda; color: #fff; font-size: 15px; font-weight: 700; cursor: pointer;
      }
      .pay:hover { background: #0a6fc2; }
      .pay:disabled { background: #b9c2cd; cursor: not-allowed; }
      .secondary {
        display: flex; gap: 10px; margin-top: 10px;
      }
      .linkish {
        flex: 1; padding: 10px; border: 1px solid #cfd6e0; border-radius: 7px;
        background: #fff; color: #55606f; font-size: 12px; font-weight: 600; cursor: pointer;
      }
      .linkish:hover { background: #f5f7fa; }
      .foot {
        margin-top: 16px; font-size: 10px; line-height: 1.6; color: #7a8695; text-align: center;
      }
      .foot strong { color: #55606f; }
      .lock { display: inline-flex; align-items: center; gap: 5px; }
      .banner {
        background: #fff4e5; border: 1px solid #ffd8a8; color: #8a5a00;
        padding: 10px 12px; border-radius: 6px; font-size: 12px; margin-bottom: 16px;
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <div class="brand">
        <div class="brand-name">Air<span>Pay</span></div>
        <div class="sandbox">Sandbox · demo</div>
      </div>

      <div class="card">
        <div class="summary">
          <div class="row">
            <span class="muted">Merchant</span>
            <span>TOKYORIDE</span>
          </div>
          <div class="row">
            <span class="muted">Order</span>
            <span style="font-family: monospace">{detail.booking.ref}</span>
          </div>
          <div class="row">
            <span class="muted">Description</span>
            <span style="text-align:right; max-width: 60%">
              {detail.tour.title}<br />
              <span class="muted" style="font-size: 11px">
                {jstLong(detail.departure.startsAt)} · {jstTime(detail.departure.startsAt)} JST
              </span>
            </span>
          </div>
          <p class="amount">{formatJpy(detail.booking.totalJpy)} <span style="font-size: 13px; font-weight: 500; color: #6a7686">JPY</span></p>
        </div>

        <div class="body">
          {expired ? (
            <>
              <div class="banner">
                This checkout is no longer active ({detail.booking.status}). Start a new booking to try again.
              </div>
              <a href={`/bookings/${detail.booking.ref}?t=${token}`} class="pay" style="display:block;text-align:center;text-decoration:none">
                Back to booking
              </a>
            </>
          ) : (
            <form method="POST" action="/api/payments/mock">
              <input type="hidden" name="bookingId" value={detail.booking.id} />
              <input type="hidden" name="token" value={token} />

              <div class="tabs">
                <div class="tab active">Card</div>
                <div class="tab">QR Ph</div>
                <div class="tab">Wallet</div>
              </div>

              <label class="label">Card number</label>
              <input class="field" value="4242 4242 4242 4242" readonly />

              <label class="label">Cardholder name</label>
              <input class="field" value={detail.customer.name} readonly />

              <div class="grid">
                <div>
                  <label class="label">Expiry</label>
                  <input class="field" value="12 / 30" readonly />
                </div>
                <div>
                  <label class="label">CVV</label>
                  <input class="field" value="•••" readonly />
                </div>
              </div>

              <button class="pay" type="submit" name="outcome" value="paid">
                Pay {formatJpy(detail.booking.totalJpy)}
              </button>

              <div class="secondary">
                <button class="linkish" type="submit" name="outcome" value="cancelled">Cancel payment</button>
                <button class="linkish" type="submit" name="outcome" value="expired">Let it expire</button>
              </div>
            </form>
          )}
        </div>
      </div>

      <p class="foot">
        <span class="lock">🔒</span> Sandbox page — no card is charged.
        The live version posts to AirPay's hosted checkout and returns through the
        signed webhook at <strong>/api/webhooks/airpay</strong>.
      </p>
    </div>
  </body>
</html>
