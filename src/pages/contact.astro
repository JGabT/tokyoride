---
import Layout from "@/layouts/Layout.astro";
import MapView from "@/components/map/MapView.tsx";
import { getSettings } from "@/lib/settings";
import { db } from "@/lib/db";
import { inquiries } from "@/lib/db/schema";
import { newId } from "@/lib/ids";

const settings = await getSettings();
let sent = Astro.url.searchParams.get("sent") === "1";
let error = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const name = String(form.get("name") ?? "").trim();
  const email = String(form.get("email") ?? "").trim();
  const topic = String(form.get("topic") ?? "general");
  const message = String(form.get("message") ?? "").trim();
  const trap = String(form.get("company") ?? "");

  if (trap) {
    return Astro.redirect("/contact?sent=1");
  }
  if (!name || !email.includes("@") || message.length < 10) {
    error = "Add your name, a valid email and a message of at least 10 characters.";
  } else {
    await db.insert(inquiries).values({
      id: newId("inq"),
      name,
      email: email.toLowerCase(),
      topic,
      message,
      status: "new",
      createdAt: Date.now(),
    });
    return Astro.redirect("/contact?sent=1");
  }
}

const points = [{ lat: settings.lat, lng: settings.lng, label: "Fujisawa base", kind: "site" as const }];
const inputClass =
  "w-full border border-ink/20 bg-paper px-3 py-2.5 text-sm text-ink placeholder:text-ink/45 focus:border-signal focus:outline-none";
const labelClass = "mono-label mb-1.5 block text-ink/65";
---

<Layout title={`Contact | ${settings.brand_name}`} description="Questions about dates, cars or convoys — talk to us.">
  <main class="mx-auto max-w-6xl px-5 py-14 sm:py-20">
    <p class="section-label">Contact</p>
    <h1 class="display mt-3 text-[clamp(2.6rem,8vw,5rem)] text-ink">
      Ask us anything<span class="text-signal">.</span>
    </h1>
    <p class="mt-5 max-w-lg text-sm leading-relaxed text-ink/70">
      Dates, convoys, under-25 drivers, or a route you want built around a
      specific car. We answer within 24 hours.
    </p>

    <div class="mt-12 grid gap-10 lg:grid-cols-[1.1fr_0.9fr]">
      <div class="border border-ink/12 bg-white p-6 sm:p-8">
        {sent ? (
          <div class="py-10 text-center">
            <p class="section-label">Message sent</p>
            <p class="mt-3 font-display text-3xl text-ink">Talk soon.</p>
            <p class="mt-3 text-sm text-ink/65">We reply within one business day.</p>
            <a href="/courses" class="hard-btn mt-6">Browse courses</a>
          </div>
        ) : (
          <form method="POST" class="space-y-4">
            {error && (
              <p class="border border-signal/40 bg-signal/10 px-3 py-2 text-xs text-ink">{error}</p>
            )}
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="name" class={labelClass}>Name</label>
                <input id="name" name="name" required class={inputClass} placeholder="Kenji Sato" />
              </div>
              <div>
                <label for="email" class={labelClass}>Email</label>
                <input id="email" name="email" type="email" required class={inputClass} placeholder="you@example.com" />
              </div>
            </div>
            <div>
              <label for="topic" class={labelClass}>What is this about?</label>
              <select id="topic" name="topic" class={inputClass}>
                <option value="booking">A booking</option>
                <option value="convoy">Convoy / group</option>
                <option value="car">A specific car</option>
                <option value="route">A custom route</option>
                <option value="general">Something else</option>
              </select>
            </div>
            <div>
              <label for="message" class={labelClass}>Message</label>
              <textarea id="message" name="message" rows="6" required class={inputClass} placeholder="Dates, group size, cars you are interested in…"></textarea>
            </div>
            <input type="text" name="company" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
            <button type="submit" class="hard-btn w-full">Send message</button>
          </form>
        )}
      </div>

      <div class="space-y-5">
        <MapView client:visible points={points} height={260} zoom={12} />

        <div class="border border-ink/12 bg-white p-6">
          <p class="section-label">Direct</p>
          <a href={`mailto:${settings.email}`} class="mt-3 block text-sm text-ink hover:text-signal">
            {settings.email}
          </a>
          <a href={`tel:${settings.phone.replace(/\s/g, "")}`} class="mt-1 block font-mono text-xs text-ink/70 hover:text-signal">
            {settings.phone}
          </a>
          <hr class="my-5 border-ink/10" />
          <p class="mono-label text-ink/50">Base</p>
          <p class="mt-2 text-sm text-ink/85">{settings.address}</p>
          <p class="mt-1 font-mono text-xs text-ink/55">{settings.hours}</p>
        </div>

        <div class="border border-ink/12 bg-white p-6">
          <p class="section-label">Response time</p>
          <p class="mt-2 text-sm leading-relaxed text-ink/70">
            Within 24 hours, usually much faster. For same-day pickup requests,
            call the number above.
          </p>
        </div>
      </div>
    </div>
  </main>
</Layout>
