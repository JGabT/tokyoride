---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { desc, eq, sql } from "drizzle-orm";
import { db } from "@/lib/db";
import { bookings, customers, departures, tours } from "@/lib/db/schema";
import { formatJpy, jstDateKey, jstTime } from "@/lib/dates";

const user = Astro.locals.user;
const status = Astro.url.searchParams.get("status") ?? "";
const valid = ["pending", "confirmed", "cancelled", "expired", "refunded"];

const rows = await db
  .select({ booking: bookings, customer: customers, tour: tours, departure: departures })
  .from(bookings)
  .innerJoin(customers, eq(customers.id, bookings.customerId))
  .innerJoin(departures, eq(departures.id, bookings.departureId))
  .innerJoin(tours, eq(tours.id, departures.tourId))
  .where(valid.includes(status) ? eq(bookings.status, status) : sql`1 = 1`)
  .orderBy(desc(bookings.createdAt))
  .limit(150);

const totals = rows.reduce((sum, r) => sum + (r.booking.status === "confirmed" ? r.booking.totalJpy : 0), 0);
---

<AdminLayout title="Bookings" active="bookings" user={user}>
  <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
    <div class="flex flex-wrap gap-2">
      <a href="/admin/bookings" class:list={["mono-label border px-3 py-1.5", !status ? "border-signal text-signal" : "border-ink/20 text-ink/65"]}>All</a>
      {valid.map((s) => (
        <a href={`/admin/bookings?status=${s}`} class:list={["mono-label border px-3 py-1.5", status === s ? "border-signal text-signal" : "border-ink/20 text-ink/65"]}>
          {s}
        </a>
      ))}
    </div>
    <p class="mono-label text-ink/50">{rows.length} bookings · {formatJpy(totals)} confirmed</p>
  </div>

  <div class="admin-card overflow-x-auto">
    <table class="w-full min-w-[760px] border-collapse text-sm">
      <thead>
        <tr class="border-b border-ink/12 text-left">
          {["Ref", "Customer", "Route", "Pickup", "Total", "Status", ""].map((h) => (
            <th class="p-3 mono-label text-ink/45">{h}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map(({ booking, customer, tour, departure }) => (
          <tr class="border-b border-ink/8 hover:bg-ink/5">
            <td class="p-3 font-mono text-sm text-ink">{booking.ref}</td>
            <td class="p-3">
              <p class="text-ink">{customer.name}</p>
              <p class="mono-label mt-1 text-ink/45">{customer.email}</p>
            </td>
            <td class="p-3 text-ink/85">{tour.title}</td>
            <td class="p-3 font-mono text-sm text-ink/75">
              {jstDateKey(departure.startsAt)} {jstTime(departure.startsAt)}
            </td>
            <td class="p-3 font-mono text-sm text-ink">{formatJpy(booking.totalJpy)}</td>
            <td class="p-3">
              <span class:list={[
                "mono-label",
                booking.status === "confirmed" ? "text-signal" : booking.status === "pending" ? "text-utility" : "text-ink/45",
              ]}>
                {booking.status}
              </span>
            </td>
            <td class="p-3">
              <a href={`/admin/bookings/${booking.id}`} class="mono-label border border-ink/20 px-2 py-1.5 text-ink/75 hover:text-ink">
                Open
              </a>
            </td>
          </tr>
        ))}
        {rows.length === 0 && (
          <tr><td colspan="7" class="p-6 text-center text-sm text-ink/55">No bookings match this filter.</td></tr>
        )}
      </tbody>
    </table>
  </div>
</AdminLayout>
