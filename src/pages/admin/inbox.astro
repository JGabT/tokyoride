---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { desc } from "drizzle-orm";
import { db } from "@/lib/db";
import { inquiries } from "@/lib/db/schema";
import { jstDateKey, jstTime } from "@/lib/dates";

const user = Astro.locals.user;
const rows = await db.select().from(inquiries).orderBy(desc(inquiries.createdAt)).limit(80);
---

<AdminLayout title="Inbox" active="inbox" user={user}>
  <div class="space-y-3">
    {rows.length === 0 && (
      <div class="admin-card p-6 text-sm text-ink/55">No messages yet.</div>
    )}
    {rows.map((item) => (
      <article class="admin-card p-5">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <p class="text-sm text-ink">{item.name} <span class="text-ink/50">·</span> <span class="font-mono text-sm text-ink/60">{item.email}</span></p>
            <p class="mono-label mt-1 text-ink/45">
              {item.topic} · {jstDateKey(item.createdAt)} {jstTime(item.createdAt)} · {item.status}
            </p>
          </div>
          <div class="flex gap-2">
            <a href={`mailto:${item.email}?subject=Re: your Tokyoride enquiry`} class="mono-label border border-ink/20 px-2 py-1.5 text-ink/70 hover:text-ink">
              Reply
            </a>
            <form method="POST" action="/api/admin/inquiry">
              <input type="hidden" name="id" value={item.id} />
              <input type="hidden" name="status" value={item.status === "new" ? "handled" : "new"} />
              <button class="mono-label border border-ink/20 px-2 py-1.5 text-ink/55 hover:text-ink">
                {item.status === "new" ? "Mark handled" : "Reopen"}
              </button>
            </form>
          </div>
        </div>
        <p class="mt-3 whitespace-pre-wrap text-sm leading-relaxed text-ink/75">{item.message}</p>
      </article>
    ))}
  </div>
</AdminLayout>
