---
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";

export async function getStaticPaths() {
  const tours = await getCollection("tours");
  return tours.map((tour) => ({
    params: { slug: tour.id },
    props: { tour },
  }));
}

const { tour } = Astro.props;
const { Content } = await render(tour);

const gygUrl = tour.data.gygActivityId
  ? `https://www.getyourguide.com/activity/-t${tour.data.gygActivityId}`
  : "#";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout
  title={`${tour.data.title} | Tokyoride`}
  description={tour.data.subtitle}
>
  <main class="max-w-6xl mx-auto px-6 py-10">
    <nav class="mb-6">
      <a
        href={`${base}/`}
        class="inline-flex items-center text-sm font-semibold text-zinc-600 hover:text-zinc-950 transition-colors"
      >
        ← Back to all tours
      </a>
    </nav>

    <div class="flex flex-col lg:flex-row gap-10 items-start">
      <div class="flex-1 w-full bg-white border border-zinc-200 rounded-xl p-8 shadow-sm">
        <div class="flex items-center gap-2 mb-4">
          <Badge
            variant="outline"
            className="text-zinc-700 border-zinc-300 bg-zinc-100"
          >
            {tour.data.durationHours} Hours
          </Badge>
          <Badge
            variant="outline"
            className="text-zinc-700 border-zinc-300 bg-zinc-100"
          >
            Fujisawa / Kanagawa
          </Badge>
        </div>

        <h1 class="text-3xl lg:text-4xl font-black tracking-tight text-zinc-950 mb-3">
          {tour.data.title}
        </h1>

        <p class="text-zinc-600 text-lg mb-8 leading-relaxed">
          {tour.data.subtitle}
        </p>

        <hr class="border-zinc-200 mb-8" />

        <div class="prose prose-zinc max-w-none text-zinc-800 leading-relaxed text-base space-y-4">
          <Content />
        </div>
      </div>

      <aside class="w-full lg:w-[380px] shrink-0 sticky top-8">
        <div class="bg-white border border-zinc-200 rounded-xl p-6 shadow-sm">
          <span class="text-xs uppercase font-mono tracking-wider text-zinc-500 block">
            Experience Price
          </span>
          <div class="mt-1 mb-6 flex items-baseline gap-2">
            <span class="text-3xl font-mono font-bold text-zinc-950">
              ¥{tour.data.priceJpy.toLocaleString()}
            </span>
            <span class="text-sm font-sans text-zinc-500">/ guest</span>
          </div>

          <div class="divide-y divide-zinc-100 border-y border-zinc-100 mb-6">
            <div class="py-3.5 flex justify-between items-center text-sm">
              <span class="text-zinc-500">Meeting Point</span>
              <span class="font-semibold text-zinc-900 text-right">
                {tour.data.meetingPoint}
              </span>
            </div>
            <div class="py-3.5 flex justify-between items-center text-sm">
              <span class="text-zinc-500">Duration</span>
              <span class="font-semibold text-zinc-900">
                {tour.data.durationHours} Hours
              </span>
            </div>
            <div class="py-3.5 flex justify-between items-center text-sm">
              <span class="text-zinc-500">Booking Partner</span>
              <span class="font-semibold text-zinc-900">
                GetYourGuide Verified
              </span>
            </div>
          </div>

          <a
            href={gygUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="block w-full"
          >
            <Button className="w-full bg-red-600 hover:bg-red-700 text-white font-semibold py-6 text-base shadow-sm cursor-pointer">
              Book on GetYourGuide
            </Button>
          </a>

          <p class="text-xs text-center text-zinc-400 mt-4">
            Instant confirmation • Free cancellation options
          </p>
        </div>
      </aside>
    </div>
  </main>
</Layout>
